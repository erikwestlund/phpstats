# Every key the app reads, with local values. A deployed .env is rendered from
# a vault outside this repo and never holds a value written here. Keys marked
# "Secret" come from the vault; keys marked "Per host" differ between staging
# (phpstats.pequod.sh) and production (phpstats.org). Every other key is the
# same on both.

APP_NAME="PHP Statistical Models"
# production on staging and production.
APP_ENV=local
# Secret, one per deployment. Generate with `php artisan key:generate --show`.
APP_KEY=
# false on staging and production.
APP_DEBUG=true
# Per host: https://phpstats.pequod.sh or https://phpstats.org.
APP_URL=http://phpstats.test

# Per host: the landing page's host, and the pattern for each package's host.
# Staging uses phpstats.pequod.sh and phpstats-{package}.pequod.sh; production
# uses phpstats.org and {package}.phpstats.org.
PHPSTATS_ROOT_HOST=phpstats.test
PHPSTATS_PACKAGE_HOST={package}.phpstats.test
# Serve everything on one host, each package under /{package}. Previews only.
PHPSTATS_PATHS=false
# Whether robots.txt invites crawlers. Leave unset when deployed: it defaults to
# true just when APP_ENV is production, and staging should set it to false.
PHPSTATS_INDEXABLE=false
# Per host: proxy IPs or CIDRs whose X-Forwarded-* headers are trusted,
# comma-separated, or *. Staging sets its reverse proxy. Production leaves it
# unset: Cloudflare reaches nginx over HTTPS and keeps the Host header.
TRUSTED_PROXIES=

# Where Vega's scripts come from: cdn, a URL prefix, or none.
PHIZ_ASSETS=none

LOG_CHANNEL=stack
LOG_STACK=single
# warning when deployed.
LOG_LEVEL=debug

# sqlite locally. Deployed sites use pgsql with DB_HOST, DB_PORT, DB_DATABASE,
# and DB_USERNAME, and DB_PASSWORD is a secret.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=phpstats
# DB_USERNAME=phpstats_app
# DB_PASSWORD=

# The site sends no mail and runs no jobs; these stay as they are when deployed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
